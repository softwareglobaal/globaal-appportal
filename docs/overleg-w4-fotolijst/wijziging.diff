+    ver = OUDE_LIJST.replace("| 71 m |", "| 450 m |")
+    assert V.fotobewijs(_fotobezoek(monkeypatch, ver), VENSTER, "2145") == "let_op"               # buiten 300 m: geen tijd
+    andere_dag = OUDE_LIJST.replace("2145 2026-06-06", "2145 2026-06-07")
