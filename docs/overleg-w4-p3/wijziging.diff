+                     (_p3_bezoek("fotos/1130 AAAA0001.heic"), "jpg_ontbreekt"),                 # lijst, alleen HEIC
+                     (_p3_bezoek("1130 AAAA0001.jpg"), "niet_in_fotomap")):                     # foto naast fotos/
+        w4, taken = _p3(monkeypatch, b)
