[Unit]
Description=RenoVision via Claude (MCP-server)
After=network.target docker.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/appportal/renovision-mcp
EnvironmentFile=/home/ubuntu/renovision-mcp.env
ExecStart=/home/ubuntu/appportal/renovision-mcp/.venv/bin/python /home/ubuntu/appportal/renovision-mcp/mcp_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
