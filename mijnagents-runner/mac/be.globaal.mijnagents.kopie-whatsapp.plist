<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MacGesprekkenKopie, set whatsapp (ontwerp dagvaststelling v2.0, fase 2): het enige programma met Full Disk Access.
     Geen schema: De WhatsApp-wacht start deze taak met launchctl kickstart, zodat de helper zelf het
     verantwoordelijke proces is. Plaatsen en laden: mac/uitrol_mac_gesprekken.sh. -->
<plist version="1.0"><dict>
  <key>Label</key><string>be.globaal.mijnagents.kopie-whatsapp</string>
  <key>ProgramArguments</key><array>
    <string>@THUIS@/Library/Application Support/mijnagents/mac-gesprekken/MacGesprekkenKopie</string>
    <string>whatsapp</string>
  </array>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@THUIS@/Library/Logs/mijnagents/kopie-whatsapp.log</string>
  <key>StandardErrorPath</key><string>@THUIS@/Library/Logs/mijnagents/kopie-whatsapp.log</string>
</dict></plist>
