# Copy this file to .env and fill in real values. .env is gitignored.
# Generate secrets with:  openssl rand -base64 48
# PowerShell: [Convert]::ToBase64String((1..36 | ForEach-Object {Get-Random -Max 256}))

# Base domain for all hostnames: portal.<BASE_DOMAIN>, auth.<BASE_DOMAIN>, etc.
# - Local development: localhost  (browsers resolve *.localhost automatically)
# - AWS VM without DNS: <public-ip-with-dashes>.sslip.io   e.g. 52-1-2-3.sslip.io
BASE_DOMAIN=localhost

# PostgreSQL password for Authentik's database (max 99 characters).
PG_PASS=CHANGE_ME

# Authentik cryptographic secret key. Generate once, never change afterwards.
AUTHENTIK_SECRET_KEY=CHANGE_ME

# Initial password for the built-in Authentik admin user 'akadmin'.
# Only read on the very first startup (empty database).
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# Flask session-signing key for the portal.
PORTAL_SECRET_KEY=CHANGE_ME

# Hostnames covered by the generated TLS certificate. Only set this when you
# add an application (append its subdomain); certs regenerate on next startup.
#CERT_SUBDOMAINS=auth portal factorydocs inventory finance maintenance

# OIDC client credentials for the portal. You get these from Authentik AFTER
# the one-time setup (README step "Create the portal OIDC provider").
# Leave as-is for the very first startup, fill in later, then:
#   docker compose up -d portal
OIDC_CLIENT_ID=not-configured-yet
OIDC_CLIENT_SECRET=not-configured-yet

# Read-only Authentik API token for the portal's admin "Access overview" page
# (shows which users can access each app). Create a service account + token in
# Authentik — see the README ("Access overview"). Leave empty to disable the
# page (it then shows a "not configured" notice instead of crashing).
AUTHENTIK_API_TOKEN=

# Read-only Authentik API token for the Medewerkers app's "Toegang (Authentik)"
# panel (shows a person's groups + the apps those groups grant). Create with:
#   sh scripts/ak-exec.sh scripts/add-medewerkers-readonly-token.py
# Leave empty to disable the panel (it then shows "koppeling niet geconfigureerd").
MEDEWERKERS_AUTHENTIK_TOKEN=

# Claude API key for the Organisatie-dashboard's AI-lezer (graph Q&A).
# Create at https://console.anthropic.com -> API keys. Leave empty to disable
# the AI panel (the graph itself keeps working). Optional: AI_MODEL override.
ANTHROPIC_API_KEY=
#AI_MODEL=claude-sonnet-5

# Fathom API keys (comma-separated, one per recorder account) for the Second
# Brain meeting sync. Create at Fathom -> Settings -> API. Leave empty to disable.
FATHOM_API_KEYS=

# Communicatie dashboard: connection string for the 'communicatie' DB role
# (reads kern, writes schema communicatie — see db/roles.sql). Node/Knex style:
#   COMMUNICATIE_DB_URL=postgres://communicatie:PASSWORD@postgresql:5432/appportal
COMMUNICATIE_DB_URL=

# Items — verkoop-etalage tweedehands ICT. Rol 'items_writer' (schema items,
# db/migrations/079-items.sql). psycopg3-style:
#   ITEMS_DB_URL=postgresql+psycopg://items_writer:PASSWORD@postgresql:5432/appportal
ITEMS_DB_URL=
# Optioneel: komma-gescheiden Authentik-groepen die mogen bewerken (leeg = allen).
ITEMS_EDITOR_GROUPS=
# Telefoonnummer op de publieke site (angela.sr). Leeg = niet tonen.
CONTACT_TELEFOON=
# WhatsApp-nummer in internationale vorm (bv. +597 ...). Leeg = alleen de tekst
# "mail of WhatsApp"; gezet = wa.me-knoppen in kop, hero, koopblok, footer en artikel.
WHATSAPP_NUMMER=
# Munt van de publieke site. Leeg = de app-default: $ en USD (Amerikaanse
# dollar). Zet MUNT_SYMBOOL/MUNT_CODE op SRD als er ooit in Surinaamse dollar
# gerekend wordt; dat verandert alleen het label, niet de opgeslagen bedragen.
MUNT_SYMBOOL=
MUNT_CODE=

# Angela - werkdashboard initiatief Suriname. Rol 'angela_writer' (schema
# angela, leest kern.persoon; db/migrations/097-angela.sql). psycopg3-style:
#   ANGELA_DB_URL=postgresql+psycopg://angela_writer:PASSWORD@postgresql:5432/appportal
ANGELA_DB_URL=
# Optioneel: komma-gescheiden Authentik-groepen die mogen bewerken (leeg = allen).
ANGELA_EDITOR_GROUPS=

# Boekhouding - factureren vanuit Monday naar Octopus, plus openstaande posten.
# Rol 'boekhouding_writer' (schema boekhouding, leest kern.firma en kern.partij;
# db/migrations/102-boekhouding.sql). psycopg3-style:
#   BOEKHOUDING_DB_URL=postgresql://boekhouding_writer:PASSWORD@postgresql:5432/appportal
BOEKHOUDING_DB_URL=
# Optioneel: komma-gescheiden Authentik-groepen naast admin (standaard boekhouding,manager).
BOEKHOUDING_GROUPS=
# Octopus REST-API: hergebruikt OCTOPUS_SOFTWAREHOUSE_UUID/USER/PASSWORD die
# hierboven al voor de Octopus-spiegel staan. Niets extra in te vullen.
# Persoonlijk Monday-token met leesrecht op de Finance-, Projects- en
# Client-boards en schrijfrecht op de Finance-kolommen. Eigen token voor deze
# app, los van de Monday-koppeling van de zandbak.
MONDAY_BOEKHOUDING_TOKEN=
# Boekhouding MCP: Claude leest hierlangs de Octopus-gegevens (alleen lezen).
# Beide leeg = het endpoint bestaat niet. Genereren met bijvoorbeeld
#   openssl rand -hex 32
# BOEKHOUDING_MCP_TOKEN is het statische token voor Claude Code/desktop,
# BOEKHOUDING_MCP_SECRET tekent de OAuth-tokens voor de claude.ai-connector.
BOEKHOUDING_MCP_TOKEN=
BOEKHOUDING_MCP_SECRET=

# Contracten MCP: Claude leest hierlangs de contractdossiers (alleen lezen).
# Beide leeg = het endpoint bestaat niet. Genereren met bijvoorbeeld
#   openssl rand -hex 32
# CONTRACTEN_MCP_TOKEN is het statische token voor Claude Code/desktop,
# CONTRACTEN_MCP_SECRET tekent de OAuth-tokens voor de claude.ai-connector.
CONTRACTEN_MCP_TOKEN=
CONTRACTEN_MCP_SECRET=

# Intercompany - onderlinge facturatie tussen de eigen firma's. Spiegelt uit
# Octopus wat High Design Studio aan de Belgische firma's factureerde en wat
# daarvan betaald is. Niet te verwarren met BOEKHOUDING hierboven: dat gaat over
# facturatie aan klanten. Rol 'intercompany_writer' (schema intercompany, leest
# kern.firma; db/migrations/118-intercompany.sql). psycopg3-style:
#   INTERCOMPANY_DB_URL=postgresql://intercompany_writer:PASSWORD@postgresql:5432/appportal
INTERCOMPANY_DB_URL=
# Optioneel: komma-gescheiden Authentik-groepen naast admin (standaard
# boekhouding,manager).
INTERCOMPANY_GROUPS=
# Octopus REST-API: hergebruikt OCTOPUS_SOFTWAREHOUSE_UUID/USER/PASSWORD die
# hierboven al staan. Niets extra in te vullen.

# QuickBooks-connector voor HDS. Rol 'quickbooks_writer' (schema quickbooks,
# db/migrations/115-quickbooks.sql):
#   QUICKBOOKS_DB_URL=postgresql://quickbooks_writer:PASSWORD@postgresql:5432/appportal
QUICKBOOKS_DB_URL=
# Production keys van de Intuit-app (workspace HDS, app MCP).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# MCP voor Claude; beide leeg = het endpoint bestaat niet.
QUICKBOOKS_MCP_TOKEN=
QUICKBOOKS_MCP_SECRET=

# Postbus - mailboxtoegang voor Claude (MCP over IMAP). De mailboxen zelf
# staan buiten git in ~/post-config/mailboxen.yaml; hier staat alleen wat de
# server als geheel mag. Verwijderen kan nooit.
# Wie de beheersectie ziet (standaard admin):
POSTBUS_BEHEER_GROEPEN=
# claude.ai-connector (OAuth via SSO) en statisch token voor Claude Code;
# beide leeg = dat endpoint bestaat niet.
POSTBUS_MCP_SECRET=
POSTBUS_MCP_TOKEN=
POSTBUS_TOKEN_GROEPEN=
# Noodrem voor uitgaande post: alleen de waarde ja zet doorsturen aan. Staat
# dit leeg, dan gaat er niets de deur uit, ook niet bij een mailbox die het
# volgens mailboxen.yaml mag.
POSTBUS_DOORSTUREN=
# Hoeveel uitgaande berichten er per dag maximaal uit mogen (standaard 100).
# Geldt samen voor doorsturen en versturen.
POSTBUS_DOORSTUREN_DAGPLAFOND=
# Noodrem voor verwijderen: alleen de waarde ja laat een bericht naar de
# prullenbak gaan, en dan nog alleen bij een mailbox met 'verwijderen: ja'.
POSTBUS_VERWIJDEREN=
# Noodrem voor versturen van een zelf opgesteld bericht: alleen de waarde ja
# zet het aan, en dan nog alleen bij een mailbox met 'verzenden: ja'.
POSTBUS_VERZENDEN=

# Doorstuuragent (app-post-agent): stuurt uit zichzelf door, los van de
# connector. De regel: welke mailbox, welk onderwerp, waarheen. De bestemming
# moet ook in de doorsturen-lijst van die mailbox in mailboxen.yaml staan.
# Voorbeeld: de Anthropic-facturen van mch naar de boekhouding.
POSTBUS_AGENT_MAILBOX=
POSTBUS_AGENT_ONDERWERP=
POSTBUS_AGENT_NAAR=
# Map om in te kijken (standaard INBOX) en het ritme in seconden (standaard 300).
POSTBUS_AGENT_MAP=
POSTBUS_AGENT_INTERVAL=
# Leeg = bij de eerste start bestaande berichten NIET doorsturen, alleen
# onthouden. ja = de geschiedenis alsnog in een keer doorsturen.
POSTBUS_AGENT_BACKFILL=

# Pipedrive - de vijf verkoopadministraties. Een token per firma, aangemaakt in
# Pipedrive zelf (Persoonlijke instellingen > API). Gebruikt door het
# sales-dashboard (vier ervan) en door de MCP-koppeling pipedrive-mcp (alle
# vijf). Rotatie hoeft dus maar op een plek.
PIPEDRIVE_TOKEN_HARCHITECTS=
PIPEDRIVE_TOKEN_UNABO=
PIPEDRIVE_TOKEN_TKNBURO=
PIPEDRIVE_TOKEN_ENERGIEEFFICIENT=
PIPEDRIVE_TOKEN_HARMONIEBOUW=
# De MCP-server zelf leest deze tokens hieruit, maar heeft zijn eigen
# sleutels in ~/pipedrive-mcp.env (buiten git): MCP_SECRET tekent de
# OAuth-tokens voor de claude.ai-connector, MCP_TOKEN is de vaste sleutel voor
# beheer. Beide leeg = het endpoint bestaat niet. Daar staat ook MCP_GEBRUIKERS,
# de namenlijst die bepaalt wie met de koppeling mag werken (nu alleen mehdi).
# Zie pipedrive-mcp/README.md.
