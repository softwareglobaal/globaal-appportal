# Sales-dashboard — sales.globaal.be
# Forward-auth (Authentik) beschermt de hele app; de identiteit gaat als
# X-authentik-* headers naar de Next.js-app (EDITOR_USERS bepaalt wie
# mag schrijven). Hersteld 2026-08-24: deze vhost stond alleen als
# VM-drift op de server en was verdwenen, waardoor sales.globaal.be op
# het standaard-serverblok (Authentik) uitkwam.
server {
    listen 443 ssl;
    http2 on;
    server_name sales.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Privé dashboard: niet indexeren.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Docker-DNS + variabele proxy_pass: een herbouw van de container
    # (nieuw IP) vraagt dan geen nginx-herlading.
    set $app_upstream http://app-sales:3008;

    # Agent-API (zie docs/AGENT-API.md in de sales-repo). Een agent heeft geen
    # browsersessie en kan dus niet door de Authentik-poort; deze routes gaan er
    # daarom langs. De app bewaakt ze zelf met SALES_AGENT_TOKEN. De
    # identiteitsheaders worden hard geleegd, zodat een agent zich niet als
    # gebruiker kan voordoen.
    location /api/v1/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups   "";
        proxy_set_header X-authentik-email    "";
        proxy_set_header X-authentik-name     "";
        proxy_set_header X-authentik-uid      "";
        proxy_pass $app_upstream;
    }
    include /etc/nginx/snippets/forward-auth.conf;
}
