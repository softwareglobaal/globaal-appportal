# Sales-dashboard — sales.globaal.be
# Forward-auth (Authentik) beschermt de hele app; de identiteit gaat als
# X-authentik-* headers naar de Next.js-app (EDITOR_USERS bepaalt wie
# mag schrijven). Hersteld 2026-08-24: deze vhost stond alleen als
# VM-drift op de server en was verdwenen, waardoor sales.globaal.be op
# het standaard-serverblok (Authentik) uitkwam.
server {
    listen 443 ssl;
    http2 on;
    server_name sales.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Privé dashboard: niet indexeren.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Docker-DNS + variabele proxy_pass: een herbouw van de container
    # (nieuw IP) vraagt dan geen nginx-herlading.
    set $app_upstream http://app-sales:3008;

    # Agent-API (zie docs/AGENT-API.md in de sales-repo). Een agent heeft geen
    # browsersessie en kan dus niet door de Authentik-poort; deze routes gaan er
    # daarom langs. De app bewaakt ze zelf met SALES_AGENT_TOKEN. De
    # identiteitsheaders worden hard geleegd, zodat een agent zich niet als
    # gebruiker kan voordoen.
    location /api/v1/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups   "";
        proxy_set_header X-authentik-email    "";
        proxy_set_header X-authentik-name     "";
        proxy_set_header X-authentik-uid      "";
        proxy_pass $app_upstream;
    }
    # Contracten (H-Architects) draait onder deze tegel op /contracten/.
    # Bewust géén eigen subdomein en géén eigen Authentik-app: Mehdi wil
    # één tegel, niet twee. De forward-auth hieronder dekt ook dit pad, want
    # auth_request geldt per locatie en staat hier expliciet herhaald.
    # X-Forwarded-Prefix vertelt de Flask-app onder welk pad hij hangt, zodat
    # zijn links kloppen.
    location ^~ /contracten/ {
        auth_request     /outpost.goauthentik.io/auth/nginx;
        error_page       401 = @goauthentik_proxy_signin;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header       Set-Cookie $auth_cookie;

        auth_request_set $c_username $upstream_http_x_authentik_username;
        auth_request_set $c_groups   $upstream_http_x_authentik_groups;
        auth_request_set $c_email    $upstream_http_x_authentik_email;
        proxy_set_header X-authentik-username $c_username;
        proxy_set_header X-authentik-groups   $c_groups;
        proxy_set_header X-authentik-email    $c_email;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix /contracten;

        # Een dossiercontrole bevraagt Pipedrive, Geopunt en de mailbox; het
        # genereren van een contract met pdf-conversie duurt nog langer.
        # De standaard van 60 seconden is daarvoor te kort.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 64m;

        proxy_pass http://app-contracten:3022;
    }

    include /etc/nginx/snippets/forward-auth.conf;
}
