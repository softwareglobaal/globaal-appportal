server {
    listen 443 ssl;
    http2 on;
    server_name mijnagents.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Mehdi's eigen agent-omgeving. Forward-auth (embedded outpost) beschermt
    # de hele tegel; identiteit + groepen gaan als X-authentik-* headers naar
    # de Flask-app. Zichtbaar voor admin, manager en agents.
    set $app_upstream http://app-mijnagents:3022;

    # Statusmeldingen van de runners: een agent heeft geen browsersessie, dus
    # deze ene POST passeert de forward-auth en de app controleert zelf een
    # gedeeld token (AGENTS_TOKEN). Alleen een kleine body; de
    # identiteitsheaders worden hard geleegd.
    location = /agent-status {
        client_max_body_size 8k;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }

    # Runners buiten de VM (de iCloud-wacht op Mehdi's Mac) zetten klaar en
    # schrijven hun werkverslag: zelfde tokenslot, zelfde geleegde identiteit.
    location = /api/klaarzet {
        client_max_body_size 2m;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }
    location ~ ^/api/klaarzet/[0-9]+/opgepakt$ {
        client_max_body_size 2m;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }
    location = /api/gesprekken {
        client_max_body_size 2m;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }
    location = /api/logboek {
        client_max_body_size 1m;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }

    # MCP voor Mehdi's Claude (roep_mehdi, 25-09-2026): zelfde opbouw als de
    # Postbus. /oauth/authorize en /mcp staan buiten de forward-auth (de app
    # controleert zelf het getekende token); /oauth/inloggen staat er WEL
    # achter, daar is de SSO-login de authenticatie. Zonder
    # MIJNAGENTS_MCP_SECRET geeft de app 404.
    location = /oauth/authorize {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }
    location ^~ /mcp {
        client_max_body_size 64k;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }
    location ^~ /.well-known/oauth- {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
    location = /.well-known/openid-configuration {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }

    # De stem van De Bode: Twilio opent hier een WebSocket met het geluid van
    # het gesprek. Buiten de forward-auth (Twilio heeft geen SSO); de
    # spraakserver weigert elke stroom zonder geldig teken (HMAC).
    location = /stem/ws {
        set $stem_upstream http://app-mijnagents-stem:3040;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass $stem_upstream;
    }

    include /etc/nginx/snippets/forward-auth.conf;
}
