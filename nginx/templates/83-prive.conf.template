server {
    listen 443 ssl;
    http2 on;
    server_name prive.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Foto's van bonnetjes vanaf de iPhone (de app weigert zelf boven 15 MB).
    client_max_body_size 16m;

    # Privéadministratie: niet indexeren.
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Forward-auth (embedded outpost) beschermt de hele app; identiteit en
    # groepen gaan als X-authentik-* headers naar de Flask-app, die daar zelf
    # nog eens PRIVE_GROUPS (prive-mehdi) tegen aftoetst.
    set $app_upstream http://app-prive:3041;
    include /etc/nginx/snippets/forward-auth.conf;
}
