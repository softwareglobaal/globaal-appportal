# Het portaal via Claude: alle applicaties leesbaar, met je eigen rechten.
#
# De dienst draait op de host (172.17.0.1:8113, systemd portal-mcp), niet in
# een container: hij praat met beide databases op de loopback (5433) en heeft
# verder niets uit het compose-netwerk nodig.
#
# **Geen forward-auth, anders dan bij vermogen, renovision en pipedrive.** Die
# zetten hun loginstap achter de forward-auth, en die neemt over wie er
# toevallig in de browser is ingelogd. Op een gedeelde PC koppelt de tweede
# collega dan als de eerste, zonder foutmelding. Deze dienst is zelf een
# OIDC-client van Authentik en stuurt `prompt=login` mee, zodat er altijd
# opnieuw ingelogd moet worden. Zie portal-mcp/mcp_server.py.
#
# Daardoor is er hier ook geen `location /` met auth_request. Alles wat we niet
# uitdrukkelijk openzetten geeft 404: er valt achter deze vhost niets te halen
# behalve de endpoints hieronder.

server {
    listen 443 ssl;
    http2 on;
    server_name portal-mcp.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Variabele proxy_pass plus de docker-resolver, zodat een herstart van de
    # dienst geen nginx-herlaad nodig heeft.
    resolver 127.0.0.11 valid=30s;
    set $app_upstream http://172.17.0.1:8113;

    # De outpost-buffers uit de forward-auth-snippet zitten hier niet, maar de
    # antwoorden van Authentik bij de OIDC-sprong kunnen ook groot zijn.
    proxy_buffers 8 16k;
    proxy_buffer_size 32k;

    location ^~ /mcp {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
        # Een query over een groot schema mag even duren; de dienst kapt zelf
        # af op 15 seconden (statement_timeout).
        proxy_read_timeout 60s;
    }

    # De koppelstap: /oauth/authorize stuurt door naar Authentik,
    # /oauth/terug vangt hem daarna weer op.
    location ^~ /oauth/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }

    # OAuth-discovery (RFC 8414/9728), publiek leesbaar.
    location ^~ /.well-known/oauth- {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
    location = /.well-known/openid-configuration {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }

    # Gezondheidscheck voor Uptime-Kuma: zegt of beide databases bereikbaar
    # zijn en hoeveel applicaties de cataloog kent. Geeft geen data prijs.
    location = /gezond {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }

    location / {
        return 404;
    }
}
