# Het portaal via Claude: alle applicaties leesbaar, met je eigen rechten.
#
# De dienst draait op de host (172.17.0.1:8113, systemd portal-mcp), niet in
# een container: hij praat met beide databases op de loopback (5433) en heeft
# verder niets uit het compose-netwerk nodig.
#
# Zelfde indeling als vermogen, renovision en pipedrive: /mcp en de
# OAuth-metadata staan buiten de forward-auth (MCP-clients hebben geen
# Authentik-sessie; de dienst controleert zelf het bearer-token), en de
# loginstap /oauth/authorize valt er juist WEL onder. Daar is SSO de
# authenticatie, en daar wordt vastgesteld wie er koppelt. Zonder MCP_SECRET in
# de omgeving geeft de dienst 404.
#
# Let op: geen proxy_buffers hier. De forward-auth-snippet zet die al, en nginx
# weigert een dubbele directive; dat legde op 31-08-2026 het hele platform plat.

server {
    listen 443 ssl;
    http2 on;
    server_name portal-mcp.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    set $app_upstream http://172.17.0.1:8113;
    include /etc/nginx/snippets/forward-auth.conf;

    location ^~ /mcp {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
        # Een query over een groot schema mag even duren; de dienst kapt zelf
        # af op 15 seconden (statement_timeout).
        proxy_read_timeout 60s;
    }

    # OAuth-discovery (RFC 8414/9728), publiek leesbaar.
    location ^~ /.well-known/oauth- {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
    location = /.well-known/openid-configuration {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }

    # Gezondheidscheck voor Uptime-Kuma: zegt of beide databases bereikbaar
    # zijn en hoeveel applicaties de cataloog kent. Geeft geen data prijs.
    location = /gezond {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
}
