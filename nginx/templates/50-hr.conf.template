server {
    listen 443 ssl;
    http2 on;
    server_name hr.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # HR-dashboard (HDS, DeskTime). Vertrouwelijke personeelsdata: alleen
    # achter forward-auth, en de app controleert zelf nog eens op de groepen
    # hr/manager/admin. Het gegenereerde bestand is enkele megabytes, dus
    # ruimere buffers en compressie.
    set $app_upstream http://app-hr:3013;
    gzip on;
    gzip_types text/html;
    gzip_min_length 4096;
    proxy_buffering off;
    include /etc/nginx/snippets/forward-auth.conf;

    # Aflevering van het dashboard door Genereer-Dashboard.ps1 op de pc van
    # HR: buiten de forward-auth om, want dat script heeft geen
    # Authentik-sessie. De beveiliging is hier de header X-Upload-Token, die
    # de app vergelijkt met HR_UPLOAD_TOKEN; zonder die variabele antwoordt
    # de app 503 en kan er dus niets binnenkomen. Het bestand is 5-10 MB,
    # ruim boven de nginx-standaard van 1 MB, en een trage upload mag de
    # verbinding niet verliezen.
    location = /upload {
        client_max_body_size 64m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }
}
