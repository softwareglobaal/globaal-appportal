# WhatsApp - whatsapp.${BASE_DOMAIN}
#
# De inbox staat achter forward-auth. Alleen /meta/ staat erbuiten: Meta heeft
# geen Authentik-sessie. Daar beschermt de app zelf met een geheim pad
# (WHATSAPP_WEBHOOK_GEHEIM, ook het verify token) en X-Hub-Signature-256 met
# het app-geheim. Een verkeerd pad geeft 404.
#
# GET is nodig voor de eenmalige verificatie door Meta, POST voor de
# berichten. Een webhook kan meerdere berichten bundelen, vandaar 256k.

limit_req_zone $binary_remote_addr zone=whatsapp_meta:1m rate=30r/s;

server {
    listen 443 ssl;
    http2 on;
    server_name whatsapp.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    set $app_upstream http://app-whatsapp:3033;
    include /etc/nginx/snippets/forward-auth.conf;

    location ^~ /meta/ {
        limit_req zone=whatsapp_meta burst=60 nodelay;
        limit_except GET POST { deny all; }
        client_max_body_size 256k;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }
}
