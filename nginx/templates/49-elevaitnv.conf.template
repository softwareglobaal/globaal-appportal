# Productie: elevaitnv.com. Eigen Let's Encrypt-certificaat, want het
# wildcard-cert van *.globaal.be dekt dit domein niet. Eerst het
# certificaat aanvragen (zie DEPLOY-ELEVAIT.md in de repo elevaitnv-website),
# daarna pas deze template plaatsen: nginx start niet met een verwijzing
# naar een certificaat dat nog niet bestaat.
#
# Deze vhost hoort in de stack-repo en nergens anders. Hij stond tot
# 31-07-2026 als handmatig gekopieerd, niet-getrackt bestand op de VM en is
# daar spoorloos verdwenen; het gevolg was dat nginx terugviel op het
# standaardblok en bezoekers van elevaitnv.com het certificaat van
# globaal.be kregen, met een browserwaarschuwing.

server {
    listen 80;
    server_name elevaitnv.com www.elevaitnv.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://elevaitnv.com$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.elevaitnv.com;
    ssl_certificate /etc/nginx/certs/elevaitnv/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/elevaitnv/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://elevaitnv.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name elevaitnv.com;
    ssl_certificate /etc/nginx/certs/elevaitnv/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/elevaitnv/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Sollicitaties met CV-upload mogen tot 10 MB groot zijn.
    client_max_body_size 10m;

    # Variabele upstreams + de Docker-resolver. Zonder dit zoekt nginx beide
    # containers op bij het opstarten, en weigert hij te starten als er een
    # ontbreekt: dan ligt niet deze site plat maar het hele platform, want
    # nginx bedient alle vhosts. Dit blok sluit geen forward-auth in (de site
    # is openbaar), dus de resolver staat hier zelf.
    resolver 127.0.0.11 valid=30s;
    set $demo_upstream http://demo-kennisbank:3030;
    set $site_upstream http://elevait-web:8090;

    # Publieke demo van de kennisbank (elevaitnv.com/demo). Openbaar, dus geen
    # SSO. De app bewaakt zelf zijn grenzen: 40 bladzijden, 15 MB, alleen een
    # PDF met tekstlaag, vijf per dag per IP, een verwerking tegelijk.
    #
    # Ruimer dan de rest van de site, want hier komt een document binnen; het
    # verwerken duurt seconden tot een halve minuut, vandaar de langere
    # wachttijden. X-Forwarded-For moet kloppen, anders telt de daglimiet
    # iedereen als dezelfde bezoeker.
    location /demo {
        client_max_body_size 16m;
        client_body_timeout 120s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_pass $demo_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $site_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
