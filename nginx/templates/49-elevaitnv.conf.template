# Oud domein: elevaitnv.com. Sinds 21-09-2026 heet de site elevaitservices.com; dit domein
# verwijst er permanent naartoe. Bewust een 301 en geen lege site: zo blijven bestaande links,
# visitekaartjes en de positie in Google werken, en komt iedereen op het nieuwe adres uit.
#
# Het certificaat blijft nodig zolang dit domein bestaat, anders krijgt een bezoeker die
# https://elevaitnv.com intikt eerst een waarschuwing en pas daarna de doorverwijzing.
# intern.elevaitnv.com staat NIET in dit bestand; dat blijft 50-elevait-intern.conf.template.

server {
    listen 80;
    server_name elevaitnv.com www.elevaitnv.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://elevaitservices.com$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name elevaitnv.com www.elevaitnv.com;
    ssl_certificate /etc/nginx/certs/elevaitnv/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/elevaitnv/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://elevaitservices.com$request_uri;
}
