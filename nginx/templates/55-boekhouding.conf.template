server {
    listen 443 ssl;
    http2 on;
    server_name boekhouding.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Boekhouding: factureren vanuit Monday naar Octopus, en de opvolging van
    # openstaande posten. Alleen achter forward-auth; de app controleert zelf
    # nog eens op de groepen boekhouding/manager/admin. De scan praat met
    # Monday en Octopus en duurt tientallen seconden, vandaar de ruime
    # lees-timeout op de proxy.
    set $app_upstream http://app-boekhouding:3014;
    proxy_read_timeout 300s;
    include /etc/nginx/snippets/forward-auth.conf;

    # MCP-endpoint voor Claude: buiten de forward-auth om, want een MCP-client
    # heeft geen Authentik-sessie; de app checkt zelf het token. Dekt ook de
    # OAuth-endpoints voor claude.ai-connectors (/mcp/token, /mcp/register).
    # De loginstap (/oauth/authorize) valt bewust WEL onder de forward-auth
    # hierboven: SSO is daar de authenticatie. Zolang BOEKHOUDING_MCP_TOKEN en
    # BOEKHOUDING_MCP_SECRET niet in .env staan geeft het endpoint 404.
    location ^~ /mcp {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }

    # OAuth-discovery, publiek leesbaar.
    location ^~ /.well-known/oauth- {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
    location = /.well-known/openid-configuration {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
}
