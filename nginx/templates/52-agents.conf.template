server {
    listen 443 ssl;
    http2 on;
    server_name agents.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Forward-auth (embedded outpost) beschermt de hele tegel; identiteit +
    # groepen gaan als X-authentik-* headers naar de Flask-app.
    set $app_upstream http://app-agents:3020;

    # Statusmeldingen van de agents: een agent heeft geen browsersessie, dus
    # deze ene POST passeert de forward-auth en de app controleert zelf een
    # gedeeld token (AGENTS_TOKEN). Alleen een kleine body; de
    # identiteitsheaders worden hard geleegd.
    location = /agent-status {
        client_max_body_size 4k;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        proxy_pass $app_upstream;
    }

    # Contactformulieren van onze eigen websites: een bezoeker heeft geen login,
    # dus deze ene POST passeert de forward-auth. De app valideert zelf en houdt
    # spam tegen; identiteitsheaders worden hard geleegd.
    # Documenten aanleveren voor de ingestie-agent. Achter de SSO, maar de
    # standaardgrens van nginx is 1 MB en daar past geen enkel document in:
    # zelfs een handleiding van 1,3 MB liep stuk. Een gescand boek is 169 MB.
    # De OCR-post knipt te grote bestanden zelf in delen, dus hier hoeft alleen
    # het volume en de tijd te passen.
    location = /ingestie/aanleveren {
        client_max_body_size 400m;
        client_body_timeout 900s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_pass $app_upstream;
    }

    location = /website-aanvraag {
        # Ruimer dan de rest: bezoekers sturen hier foto's van de bestaande toestand
        # en pdf-plannen mee. De app bewaakt zelf het aantal (6) en de grootte per
        # bestand (12 MB) en weigert alles behalve beeld en pdf. Deze waarde is
        # bewust net iets ruimer dan 6 x 12 MB.
        client_max_body_size 80m;
        client_body_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups "";
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
        proxy_pass $app_upstream;
    }

    include /etc/nginx/snippets/forward-auth.conf;
}
