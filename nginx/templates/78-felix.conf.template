server {
    listen 443 ssl;
    http2 on;
    server_name felix.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # FelixArchief en Percelenpas Antwerpen (13-10-2026): een eigen tegel voor Shelton, op dezelfde app als
    # Mehdi's bord (app-mijnagents). Eigen forward-auth (provider felix-proxy, groepen admin, manager, felix),
    # dus wie alleen de groep felix heeft, komt niet op mijnagents. De app zelf toont op dit domein alleen /felix
    # (felix_pagina.py, before_request); al de rest is 404.
    set $app_upstream http://app-mijnagents:3022;
    include /etc/nginx/snippets/forward-auth.conf;
}
