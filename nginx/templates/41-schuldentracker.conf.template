# Geheim dat de app eist naast de X-authentik-*-koppen (X-SSO-Secret), zodat
# niemand die poort 5050 rechtstreeks bereikt zich als gebruiker kan voordoen.
# Waarde alleen in de .env op de VM: SSO_SHARED_SECRET in ~/appportal/.env
# (via docker-compose.yml naar nginx) en dezelfde waarde onder dezelfde naam in
# ~/Finance/Schuldentracker/.env. Nooit een letterlijke waarde hier: de repo is
# publiek, en de grendel geheimen-grendels.yml faalt op elke lange hex-reeks.
# Roteren: scripts/schuldentracker-sso-roteren.sh. forward-auth.conf zet de
# kop alleen voor deze host, leeg = niet verstuurd.
map $host $schuldentracker_sso_secret {
    default "";
    "schuldentracker.${BASE_DOMAIN}" "${SSO_SHARED_SECRET}";
}

server {
    listen 443 ssl;
    http2 on;
    server_name schuldentracker.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    set $app_upstream http://172.17.0.1:5050;
    include /etc/nginx/snippets/forward-auth.conf;

    # MCP-endpoint voor Claude (alleen lezen): buiten de forward-auth om, want
    # MCP-clients hebben geen Authentik-sessie; de app checkt zelf het token.
    # Dekt ook de OAuth-endpoints voor claude.ai-connectors: /mcp/token en
    # /mcp/register. De loginstap (/oauth/authorize) valt bewust WEL onder de
    # forward-auth hierboven: Authentik-SSO is daar de authenticatie. Zolang
    # MCP_SECRET/MCP_TOKEN niet in de .env van de app staan: 404.
    location ^~ /mcp {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }

    # OAuth-discovery (RFC 8414/9728), publiek leesbaar.
    location ^~ /.well-known/oauth- {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
    location = /.well-known/openid-configuration {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass $app_upstream;
    }
}
