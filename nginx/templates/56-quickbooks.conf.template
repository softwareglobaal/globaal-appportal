# quickbooks.${BASE_DOMAIN}: voorlopig alleen de twee juridische pagina's die
# Intuit vraagt bij het aanvragen van production keys (privacyverklaring en
# gebruiksvoorwaarden), plus een korte uitleg op de startpagina.
#
# Bewust PUBLIEK, dus geen forward-auth: de beoordelaar van Intuit moet die
# pagina's kunnen lezen zonder een account bij ons te hebben. Er staat niets
# vertrouwelijks op; het zijn de teksten die we zelf aan Intuit opgeven.
#
# Zodra de MCP-connector zelf gebouwd is komt die achter dezelfde naam te staan.
# De statische pagina's blijven dan publiek, de rest gaat achter de SSO. Het
# certificaat is het wildcard van *.${BASE_DOMAIN}, dus er is geen aparte
# certbot-stap nodig zoals bij regulariseren.be.

server {
    listen 443 ssl;
    http2 on;
    server_name quickbooks.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    root /srv/websites/quickbooks;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        # LET OP: een add_header binnen een locatieblok vervangt in nginx ALLE
        # add_header-regels van het niveau erboven, dus ze staan hier herhaald.
        # Zonder die herhaling verdwenen op 05-08-2026 bij regulariseren.be alle
        # beveiligingsheaders puur doordat er een Cache-Control bijkwam.
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri.html $uri/ =404;
    }

    access_log /var/log/nginx/quickbooks.access.log;
}
