# quickbooks.${BASE_DOMAIN}: de QuickBooks-connector (repo globaal-quickbooks,
# compose-service app-quickbooks op 3015) plus de twee juridische pagina's die
# Intuit eist voor production keys.
#
# Drie soorten paden, bewust verschillend afgeschermd:
#
#   /privacy en /terms   statisch en PUBLIEK. De beoordelaar van Intuit moet ze
#                        kunnen lezen zonder account bij ons. Er staat niets
#                        vertrouwelijks op.
#   /oauth/callback      buiten de forward-auth. Intuit stuurt de gebruiker hier
#                        terug met code, realmId en state in de querystring. De
#                        forward-auth-snippet bouwt zijn terugkeer-URL zonder
#                        encodering, dus zou bij een verlopen sessie alles na de
#                        eerste ampersand wegvallen (dat gebeurde eerder bij de
#                        boekhouding-MCP). De app controleert zelf de state, die
#                        achter de SSO is aangemaakt.
#   /oauth/disconnect    ook buiten, want Intuit kan dit adres zelf aanroepen.
#                        De app weigert daar te ontkoppelen zonder aangemelde
#                        gebruiker.
#   al het overige       achter de forward-auth, dus alleen wie de tegel mag zien.
#
# Certificaat: het wildcard van *.${BASE_DOMAIN}, geen certbot-stap nodig.

server {
    listen 443 ssl;
    http2 on;
    server_name quickbooks.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    set $app_upstream http://app-quickbooks:3015;

    # LET OP: een add_header binnen een locatieblok vervangt in nginx ALLE
    # add_header-regels van het niveau erboven, dus ze staan per blok herhaald.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /privacy {
        root /srv/websites/quickbooks;
        try_files /privacy.html =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location = /terms {
        root /srv/websites/quickbooks;
        try_files /terms.html =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location ^~ /oauth/callback {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }

    location ^~ /oauth/disconnect {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $app_upstream;
    }

    include /etc/nginx/snippets/forward-auth.conf;
}
