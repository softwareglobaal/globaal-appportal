server {
    listen 443 ssl;
    http2 on;
    server_name bouwsoft.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;

    # Bouwsoft-kloon (repo softwareglobaal/globaal-bouwsoft-kloon): de officiele
    # Bouwsoft API v1 en de schermen nagebouwd. Sinds 16-10-2026 draait hij op
    # de echte gegevens van Bouwsoft-klant 7519 (harvest), dus ALLES zit achter
    # de SSO, ook /api/ (die stond eerst open voor toevoegingen met een token).
    # Draait op de host als systemd-dienst bouwsoft-kloon op 172.17.0.1:8796.
    set $app_upstream http://172.17.0.1:8796;

    # Alleen voor de Authentik-groepen bouwsoft en admin.
    client_max_body_size 25m;
    include /etc/nginx/snippets/forward-auth.conf;
}
